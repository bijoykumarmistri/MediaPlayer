# Google Play Release Keystore Configuration
# Copy this file to "keystore.properties" (do not commit keystore.properties to git)
#
# storeFile: Path to your .jks or .keystore file (relative to project root or absolute)
# storePassword: Password for the keystore
# keyAlias: Alias name of your release key
# keyPassword: Password for the release key

storeFile=release-key.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
