<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient Golden Glow behind Chevron -->
    <path
        android:pathData="M54,54m-22,0a22,22 0 1,0 44,0a22,22 0 1,0 -44,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="24"
                android:type="radial">
                <item android:color="#33FFCD78" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Tint Fill -->
    <path
        android:pathData="M46.5,39 L46.5,69 L67.5,54 Z"
        android:fillColor="#26FFCD78" />

    <!-- Champagne Gold Play Chevron Outline -->
    <path
        android:pathData="M46.5,39 L46.5,69 L67.5,54 Z"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="46.5"
                android:startY="39"
                android:endX="67.5"
                android:endY="69"
                android:type="linear">
                <item android:color="#FFE5A3" android:offset="0.0" />
                <item android:color="#FFCD78" android:offset="0.5" />
                <item android:color="#E5AF52" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Specular Glint Highlight -->
    <path
        android:pathData="M47,39 L66.5,53.5"
        android:strokeColor="#CCFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
