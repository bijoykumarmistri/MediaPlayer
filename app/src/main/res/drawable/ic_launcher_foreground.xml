<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Precision Ring (Vinyl / Cinema Aperture) -->
    <path
        android:strokeColor="#3300E5FF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M 54,26 A 28,28 0 1 1 53.99,26" />

    <!-- Audiophile Gold Arc Accent -->
    <path
        android:strokeColor="#88FFD54F"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 74,34 A 28,28 0 0 1 82,54" />

    <!-- Center Play/Media Triangle with Electric Cyan to Neon Blue Gradient -->
    <path
        android:pathData="M44,38 L72,54 L44,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="38"
                android:endX="72"
                android:endY="70"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#0091EA" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Play Symbol Core Specular Highlight -->
    <path
        android:pathData="M45,41 L67,54 L45,67 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="45"
                android:startY="41"
                android:endX="67"
                android:endY="54"
                android:type="linear">
                <item android:color="#4DFFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sound Wave Pulse Lines at the left -->
    <path
        android:strokeColor="#FFD54F"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 37,47 L 37,61" />
    <path
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 32,50 L 32,58" />
</vector>
