<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Match USB Audio Class devices (class 1 = USB_CLASS_AUDIO) -->
    <usb-device class="1" />
    <!-- Match composite / Interface Association Descriptor (IAD) devices (class 239 = 0xEF)
         that expose an Audio Control interface (very common on UAC 2.0 dongles/DACs) -->
    <usb-device class="239" subclass="2" protocol="1" />
    <!-- Match class-0 (defined at interface level) composite USB DACs -->
    <usb-device class="0" />
</resources>
